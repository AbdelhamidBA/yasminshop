DATABASE_URL="postgresql://ecom:ecom_dev_password@localhost:5432/ecom?schema=public"
AUTH_SECRET=

# Web Push (VAPID) — best-effort order alerts to staff devices.
# OPTIONAL in development: if unset, src/lib/push.ts generates an ephemeral
# keypair at first use and logs a "DEV ONLY" warning (subscriptions stop
# delivering after a restart). REQUIRED in production: generate a stable pair
# with `npx web-push generate-vapid-keys`, set all three, and NEVER commit real
# keys. VAPID_SUBJECT must be a mailto: or https: URL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
