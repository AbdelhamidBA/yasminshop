DATABASE_URL="postgresql://ecom:ecom_dev_password@localhost:5432/ecom?schema=public"
AUTH_SECRET=

# Web Push (VAPID) — best-effort order alerts to staff devices.
# OPTIONAL in development: if unset, src/lib/push.ts generates an ephemeral
# keypair at first use and logs a "DEV ONLY" warning (subscriptions stop
# delivering after a restart). REQUIRED in production: generate a stable pair
# with `npx web-push generate-vapid-keys`, set all three, and NEVER commit real
# keys. VAPID_SUBJECT must be a mailto: or https: URL.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# SMTP — outbound e-mail (password-reset codes). OPTIONAL: with SMTP_* unset the
# app logs a warning and drops the message instead of throwing, so development
# and the e2e suite need no credentials. REQUIRED in production, or nobody can
# reset a forgotten password.
# Port 465 is implicit TLS, 587 is STARTTLS — `secure` is derived from the port.
# OVH MXplan: host ssl0.ovh.net, port 465, user = the full mailbox address.
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_USER=contact@example.com
# SMTP_PASSWORD=
# SMTP_FROM="Yasmine Shop <contact@example.com>"
